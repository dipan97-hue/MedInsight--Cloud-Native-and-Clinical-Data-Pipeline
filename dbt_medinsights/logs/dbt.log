  create or replace view `medical-analytics-510812`.`vitaldb_transformation`.`fct_summary`
  OPTIONS()
  as with pivoted_labs as (
    select * from `medical-analytics-510812`.`vitaldb_transformation`.`int_case_lab_pivot`
),

clinical as (
    select 
        caseid,
        age,
        sex,
        height,
        weight
    from `medical-analytics-510812`.`vitaldb_transformation`.`stg_clinical_data`
)

select
    c.caseid,
    c.age,
    c.sex,
    c.height,
    c.weight,
    l.glucose,
    l.lactate,
    l.hemoglobin,
    l.potassium,
    l.sodium,
    l.chloride,
    -- Clinical risk classification flag for reporting and AI tool consumption
    case 
        when l.glucose > 200 or l.glucose < 70 then 'Critical: Glucose Alert'
        when l.potassium > 5.0 or l.potassium < 3.5 then 'Warning: Electrolyte Imbalance'
        when l.hemoglobin < 11.0 then 'Warning: Low Hemoglobin'
        else 'Stable / Normal'
    end as clinical_risk_status
from clinical c
left join pivoted_labs l on c.caseid = l.case_id;


